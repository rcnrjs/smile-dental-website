# Self-Hosted n8n Configuration
# Set this to your production n8n webhook URL
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/smile-dental-chat

# Optional: Dedicated lead ingestion webhook in n8n
N8N_LEAD_WEBHOOK_URL=

# Optional: Webhook secret verification header
N8N_WEBHOOK_SECRET=

# Optional: Direct OpenAI API key if using serverless LLM mode
OPENAI_API_KEY=
